diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..8aac87cd69f4b96e29c25286ee790ebcd1351e48
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,11 @@
+'use strict';
+
+// Bound recursive AST work for GHSA-vfj7-8cjw-p6xm. This is not a general
+// resource limit for arbitrary regular expressions or brace expansion sizes.
+module.exports = depth => {
+  if (depth > 100) {
+    const error = new SyntaxError('Brace pattern nesting exceeds the safe depth limit (100)');
+    error.code = 'ERR_BRACES_DEPTH';
+    throw error;
+  }
+};
