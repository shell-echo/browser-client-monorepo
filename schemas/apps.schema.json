{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Browser Client applications",
  "type": "object",
  "required": ["schemaVersion", "apps"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "apps": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "maxLength": 48,
        "not": {
          "anyOf": [
            {
              "enum": [
                "all",
                "list",
                "doctor",
                "add",
                "remove",
                "restore",
                "recover",
                "con",
                "prn",
                "aux",
                "nul",
                "constructor",
                "prototype"
              ]
            },
            { "pattern": "^(com|lpt)[0-9]$" }
          ]
        }
      },
      "additionalProperties": {
        "type": "object",
        "required": ["type", "port"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["web", "admin", "extension"] },
          "port": { "type": "integer", "minimum": 1024, "maximum": 65535 }
        }
      }
    }
  }
}
