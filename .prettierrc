# https://prettier.io/docs/configuration

experimentalTernaries: false
experimentalOperatorPosition: "end"

printWidth: 128
tabWidth: 2
useTabs: false
semi: true
singleQuote: false
quoteProps: "as-needed"
jsxSingleQuote: false
trailingComma: "all"
bracketSpacing: true
objectWrap: "preserve"
bracketSameLine: false
arrowParens: "always"
