{
  "name": "@workspace/types",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@types/chrome": "^0.1.36"
  },
  "devDependencies": {
    "@types/node": "catalog:node",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "catalog:typescript"
  },
  "exports": {
    "./admin": "./src/admin.d.ts",
    "./common": "./src/common.d.ts",
    "./extension": "./src/extension.d.ts",
    "./web": "./src/web.d.ts"
  },
  "typesVersions": {
    "*": {
      "admin": [
        "src/admin.d.ts"
      ],
      "extension": [
        "src/extension.d.ts"
      ],
      "web": [
        "src/web.d.ts"
      ],
      "common": [
        "src/common.d.ts"
      ]
    }
  }
