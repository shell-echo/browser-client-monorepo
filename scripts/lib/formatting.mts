import { readdir, readFile, writeFile } from "node:fs/promises"
import { join } from "node:path"
import { format, getFileInfo, resolveConfig } from "prettier"
import { targets } from "./integrate.mts"
import { exists, managed } from "./workspace.mts"
import { assertAppId } from "./apps.mts"

// Only files regenerated by reinit may be rewritten. Business source, shared UI,
// editor settings and static assets must pass format:check without being changed.
export async function formatReinitFiles(root: string, selected: string[] = targets) {
  for (const target of selected) assertAppId(target)
  const paths = new Set(["package.json", "pnpm-workspace.yaml"])
  if (await exists(join(root, "apps.config.json"))) paths.add("apps.config.json")
  for (const parent of ["apps", "packages"]) {
    for (const entry of await readdir(join(root, parent), { withFileTypes: true })) {
      const path = `${parent}/${entry.name}/package.json`
      if (entry.isDirectory() && (await exists(join(root, path)))) paths.add(path)
    }
  }
  for (const target of new Set(selected)) {
    for (const entry of await readdir(join(root, "apps", target), { withFileTypes: true })) {
      if (entry.isFile() && managed(entry.name)) paths.add(`apps/${target}/${entry.name}`)
    }
  }
  const changes = []
  for (const path of [...paths].sort()) {
    const file = join(root, path)
    const info = await getFileInfo(file, { ignorePath: join(root, ".prettierignore") })
    if (info.ignored || !info.inferredParser) continue
    const original = await readFile(file, "utf8")
    const config = await resolveConfig(file, { editorconfig: true })
    const formatted = await format(original, { ...config, filepath: file })
    if (formatted !== original) changes.push({ file, path, formatted })
  }
  // Parse every candidate first; a bad generated config must fail before writes.
  for (const { file, formatted } of changes) await writeFile(file, formatted)
  return changes.map(({ path }) => path)
}
