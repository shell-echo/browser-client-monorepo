{
  "name": "browser-client",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "node scripts/app.mts run dev",
    "dev:web": "node scripts/app.mts dev web",
    "dev:admin": "node scripts/app.mts dev admin",
    "dev:extension": "node scripts/app.mts dev extension",
    "preview:extension": "node scripts/app.mts preview-ui extension",
    "extension:package": "node scripts/package-extension.mts",
    "build": "node scripts/app.mts run build",
    "format": "prettier --ignore-path .prettierignore --write .",
    "format:check": "prettier --ignore-path .prettierignore --check .",
    "theme:sync": "node scripts/sync-theme-assets.mts",
    "lint": "pnpm lint:scripts && node scripts/app.mts run lint",
    "lint:scripts": "eslint scripts packages/extension-sdk packages/eslint-config eslint.config.mjs browser-tests.config.mts",
    "typecheck": "pnpm typecheck:scripts && node scripts/app.mts run typecheck",
    "test": "node scripts/test.mts",
    "check": "pnpm app doctor && pnpm format:check && node scripts/check-extension-compat.mts && pnpm test && pnpm lint && pnpm typecheck && pnpm build && node scripts/check-extension.mts",
    "test:extension": "node scripts/test-extension.mts",
    "test:web-admin": "node scripts/test-web-admin.mts",
    "test:reinit": "node scripts/test-reinit.mts",
    "audit:security": "node scripts/audit-dependencies.mts",
    "reinit": "node scripts/reinit.mts",
    "reinit:clean": "node scripts/clean-reinit.mts",
    "ui:add": "pnpm --filter @browser-client/ui exec shadcn add",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "app": "node scripts/app.mts",
    "test:browser": "node scripts/test-browser.mts",
    "test:accessibility": "node scripts/test-accessibility.mts",
    "test:apps": "node scripts/test-apps.mts",
    "verify:low": "node scripts/verify-low-resource.mts"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "@browser-client/eslint-config": "workspace:*",
    "es-module-lexer": "3.0.4",
    "eslint": "catalog:",
    "jsonc-parser": "3.3.1",
    "oxlint": "catalog:",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "semver": "7.8.5",
    "shadcn": "catalog:",
    "turbo": "2.11.8",
    "yaml": "2.9.1",
    "@browser-client/typescript-config": "workspace:*",
    "typescript": "catalog:tooling",
    "@types/node": "catalog:tooling",
    "@types/chrome": "0.3.5",
    "@types/semver": "7.8.0"
  }
}
