{
  "name": "browser-client-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "lint": "turbo run lint",
    "spellcheck": "cspell lint --config .cspell.json \"**/*\"",
    "test": "turbo run test",
    "check-types": "turbo run check-types --continue=always"
  },
  "dependencies": {
    "@workspace/constant": "workspace:*",
    "@workspace/helper": "workspace:*",
    "@workspace/logger": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^4.0.18",
    "cspell": "^9.6.4",
    "eslint": "^9.39.2",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.11",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  }
}
