{
  "name": "browser-client",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @browser-client/web dev",
    "dev:admin": "pnpm --filter @browser-client/admin dev",
    "dev:extension": "pnpm --filter @browser-client/extension dev",
    "preview:extension": "pnpm --filter @browser-client/extension preview:ui",
    "build": "turbo run build",
    "lint": "pnpm lint:scripts && turbo run lint",
    "lint:scripts": "eslint scripts packages/eslint-config eslint.config.mjs",
    "typecheck": "turbo run typecheck",
    "test": "node --test --test-concurrency=2 --test-timeout=180000 scripts/tests/*.test.mjs",
    "check": "node scripts/check-extension-compat.mjs && pnpm test && pnpm lint && pnpm typecheck && pnpm build && node scripts/check-extension.mjs",
    "test:extension": "node scripts/test-extension.mjs",
    "test:web-admin": "node scripts/test-web-admin.mjs",
    "audit:security": "node scripts/audit-dependencies.mjs",
    "reinit": "node scripts/reinit.mjs",
    "reinit:clean": "node scripts/clean-reinit.mjs",
    "ui:add": "pnpm --filter @browser-client/web exec shadcn add"
  },
  "devDependencies": {
    "@browser-client/eslint-config": "workspace:*",
    "es-module-lexer": "3.0.4",
    "eslint": "catalog:",
    "jsonc-parser": "3.3.1",
    "playwright": "1.64.1",
    "semver": "7.8.5",
    "shadcn": "catalog:",
    "turbo": "2.11.8",
    "yaml": "2.9.1"
  }
}
