{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["packages/typescript-config/**", "packages/eslint-config/**", "packages/oxlint-config/**"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "inputs": ["$TURBO_DEFAULT$", ".env*"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "dev": { "cache": false, "persistent": true, "passThroughEnv": ["EXTENSION_DEV_PORT"] },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^typecheck"], "cache": false }
  }
}
