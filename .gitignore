# Generated files belong at repository and workspace boundaries only.
/node_modules/
/.next/
/dist/
/dist-dev/
/dist-ssr/
/.turbo/
/.reinit/
/coverage/
/out/
/build/
/*.tsbuildinfo
/apps/*/node_modules/
/apps/*/.next/
/apps/*/dist/
/apps/*/dist-dev/
/apps/*/dist-ssr/
/apps/*/.turbo/
/apps/*/.reinit/
/apps/*/coverage/
/apps/*/out/
/apps/*/build/
/apps/*/*.tsbuildinfo
/packages/*/node_modules/
/packages/*/.next/
/packages/*/dist/
/packages/*/dist-dev/
/packages/*/dist-ssr/
/packages/*/.turbo/
/packages/*/.reinit/
/packages/*/coverage/
/packages/*/out/
/packages/*/build/
/packages/*/*.tsbuildinfo

# Keep real environment files private; allow sanitized examples.
.env*
!.env.example
!.env.*.example
.DS_Store
*.log
